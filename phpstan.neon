includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - app
        - routes
        - database/factories
    tmpDir: storage/framework/phpstan
    excludePaths:
        # Défaut connu (non ignorable par PHPStan) : pas de return si markEmailAsVerified() renvoie false.
        # À corriger séparément, puis retirer cette exclusion.
        - app/Http/Controllers/Auth/VerifyEmailController.php
